{
	"name": "@thoughtfox/toolkit",
	"version": "0.1.0",
	"description": "Shared CUBE CSS + Every Layout foundations for Thought Fox SvelteKit sites: compositions, utilities, layout components, and the design-token generator.",
	"type": "module",
	"svelte": "./index.js",
	"exports": {
		".": {
			"svelte": "./index.js",
			"default": "./index.js"
		},
		"./layout": {
			"svelte": "./layout/index.js",
			"default": "./layout/index.js"
		},
		"./motion": {
			"svelte": "./motion/index.js",
			"default": "./motion/index.js"
		},
		"./tokens": "./tokens/index.js",
		"./layout/*": "./layout/*",
		"./motion/*": "./motion/*",
		"./tokens/*": "./tokens/*",
		"./type/*": "./type/*",
		"./css/reset.css": "./layout/reset.css",
		"./css/compositions/scene.css": "./motion/compositions/scene.css",
		"./css/compositions/*": "./layout/compositions/*",
		"./css/utilities/reveal.css": "./motion/utilities/reveal.css",
		"./css/utilities/text.css": "./type/utilities/text-legacy.css",
		"./css/utilities/*": "./layout/utilities/*",
		"./css/transitions/*": "./motion/transitions/*",
		"./components/SkipLink.svelte": "./layout/components/SkipLink.svelte",
		"./components/ScrollScene.svelte": "./motion/components/ScrollScene.svelte",
		"./components/layout/*": "./layout/components/*",
		"./components/transitions/*": "./motion/components/*",
		"./actions/reveal.js": "./motion/reveal.js",
		"./actions/scroll-scene.js": "./motion/scroll-scene.js",
		"./stores/motion.js": "./motion/reduced-motion.js",
		"./transitions/segue.js": "./motion/segue.js",
		"./scripts/*": "./scripts/*",
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"layout",
		"motion",
		"tokens",
		"type",
		"scripts"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wearethoughtfox/toolkit.git"
	},
	"engines": {
		"node": ">=22"
	}
}
