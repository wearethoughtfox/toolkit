		"./actions/*": "./actions/*",
		"./stores/*": "./stores/*",
		"./scripts/*": "./scripts/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/robertocarroll/toolkit.git"
	},
	"engines": {
		"node": ">=22"
	}
