{
	"name": "@thoughtfox/toolkit",
	"version": "0.1.0",
	"description": "Shared CUBE CSS + Every Layout foundations for Thought Fox SvelteKit sites: compositions, utilities, layout components, and the design-token generator.",
	"type": "module",
	"svelte": "./index.js",
	"exports": {
		".": {
			"svelte": "./index.js",
			"default": "./index.js"
		},
		"./css/*": "./css/*",
