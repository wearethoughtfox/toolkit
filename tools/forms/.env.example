# Environment variables for the PocketBase forms app.
# Set these in Coolify (the app → Environment Variables). Never commit real values.

# --- Required -----------------------------------------------------------
# 32 random characters. Encrypts PocketBase's stored settings (SMTP password).
# Make one with: openssl rand -hex 16
# Keep a copy somewhere safe: without it PocketBase can't read its settings.
PB_ENCRYPTION_KEY=

# The visitor's IP comes from this header. Correct behind Cloudflare.
TRUSTED_PROXY_HEADER=CF-Connecting-IP

# SMTP for notification emails (Amazon SES shown).
SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_TLS=true   # only for port 465
MAIL_SENDER_ADDRESS=forms@wearethoughtfox.com
MAIL_SENDER_NAME=Thought Fox forms
APP_URL=https://forms.wearethoughtfox.com

# Who gets each site's notifications (comma-separated for several).
FORMS_NOTIFY_BRICKHOUSE=
FORMS_NOTIFY_ROBERTOCARROLL=

# --- Optional -----------------------------------------------------------
# Newsletter signups: Maillayer's base URL (internal or public).
MAILLAYER_URL=
# Cloudflare Turnstile secret key, for forms with turnstile: true.
TURNSTILE_SECRET_KEY=
# Rate limit per IP on /api/forms/ (defaults: 5 per 60 seconds).
# FORMS_RATE_LIMIT_MAX=5
# FORMS_RATE_LIMIT_SECONDS=60
# Retention in days (defaults: real messages 365, spam 30; 0 = keep).
# FORMS_RETENTION_DAYS=365
# FORMS_SPAM_RETENTION_DAYS=30
# Keep visitors' IPs in PocketBase's request logs (off by default).
# PB_LOG_IP=true
# PocketBase's own scheduled backups.
PB_BACKUPS_CRON=30 2 * * *
PB_BACKUPS_KEEP=7
